# ── Public n8n address (a real DNS record pointing at the VPS) ────────────────
N8N_HOST=n8n.example.com
STUDIO_HOST=studio.example.com
N8N_PROTOCOL=https
N8N_PORT=5678
GENERIC_TIMEZONE=Asia/Seoul

# Generated before first start: ./scripts/init-env.sh
POSTGRES_PASSWORD=replace-with-a-long-random-password
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
VIDEO_WORKER_TOKEN=replace-with-at-least-32-random-characters
STUDIO_ACCESS_PASSWORD=replace-with-a-random-studio-password
STUDIO_SESSION_SECRET=replace-with-a-random-session-secret
STUDIO_SESSION_DAYS=30

# Google credential 1/3: Gemini API key (AIza...).
# Google credential 2/3: YouTube Data API key (AIza..., preferably separate/restricted).
# Google credential 3/3: YouTube upload OAuth Client ID/Secret is NOT stored here;
# configure it once in n8n's encrypted YouTube OAuth2 credential.
# An OAuth client secret (GOCSPX-...) and client ID (...apps.googleusercontent.com)
# do not belong in this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Separate server-side key restricted to YouTube Data API v3. It powers channel
# comparison in YouTubot. Keep it blank only if real channel analysis is unused.
YOUTUBE_DATA_API_KEY=

# Optional stock footage. Without this, the worker renders an animated branded
# background, so the pipeline still works.
PEXELS_API_KEY=

# edge: no key required. google: set GOOGLE_TTS_API_KEY and a Google voice.
TTS_PROVIDER=edge
TTS_VOICE=ko-KR-SunHiNeural
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=ko-KR-Neural2-A

# Render/storage controls
VIDEO_WORKER_BASE_URL=http://video-worker:8000
VIDEO_RETENTION_DAYS=7
MAX_VIDEO_SECONDS=60
MAX_CHAT_IMAGE_MB=10
MAX_CHAT_IMAGES=5
CHAT_HISTORY_MESSAGES=40
