              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        330,
        160
      ],
      "id": "4aa7a213-79c4-4239-ac72-4c1ce31e14aa",
      "name": "Download MP4"
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{ $('Render Video').first().json.title }}",
        "regionCode": "KR",
        "categoryId": "22",
        "binaryProperty": "data",
        "options": {
          "defaultLanguage": "ko",
          "description": "={{ $('Render Video').first().json.description }}",
          "embeddable": true,
          "license": "youtube",
          "notifySubscribers": true,
          "privacyStatus": "private",
          "publicStatsViewable": true,
          "publishAt": "={{ $('Render Video').first().json.publishAt }}",
          "selfDeclaredMadeForKids": false,
          "tags": "={{ $('Render Video').first().json.tags.join(',') }}"
        }
      },
