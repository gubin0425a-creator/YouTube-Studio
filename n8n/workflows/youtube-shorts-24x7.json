    },
    {
      "parameters": {
        "url": "http://video-worker:8000/v1/automation/config",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -720,
        160
      ],
      "id": "87f83529-c253-4d05-b79d-a950b8235f03",
      "name": "Load Automation Config",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const cfg = $input.first().json;\nconst zone = String(cfg.timezone || 'Asia/Seoul');\nconst now = DateTime.fromJSDate(new Date()).setZone(zone);\nif (!now.isValid) throw new Error(`Invalid timezone: ${zone}`);\n\nconst hour = Math.max(0, Math.min(23, Number(cfg.publishHour)));\nconst minute = Math.max(0, Math.min(59, Number(cfg.publishMinute)));\nconst minimumLead = Math.max(30, Number(cfg.minimumLeadMinutes || 120));\nlet publishAt = now.set({ hour, minute, second: 0, millisecond: 0 });\nif (publishAt.diff(now, 'minutes').minutes < minimumLead) {\n  publishAt = publishAt.plus({ days: 1 });\n}\n\nconst topics = String(cfg.topicPool || '').split(',').map(v => v.trim()).filter(Boolean);\nif (!topics.length) throw new Error('CONFIG topicPool is empty');\nconst dateKey = publishAt.toFormat('yyyy-LL-dd');\nconst hash = [...`${cfg.channelKey}:${dateKey}`].reduce((sum, ch) => ((sum * 31) + ch.charCodeAt(0)) | 0, 7);\nconst topic = topics[Math.abs(hash) % topics.length];\n\nreturn [{ json: {\n  topic,\n  language: String(cfg.language || 'ko-KR'),\n  durationSeconds: Number(cfg.durationSeconds || 45),\n  publishAt: publishAt.toUTC().toISO(),\n  idempotencyKey: `youtube-short:${dateKey}`,\n  channelKey: String(cfg.channelKey || 'main'),\n  voice: String(cfg.voice || ''),\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        160
      ],
      "id": "86cfdfe1-b6bd-4b42-bb56-31ce5eb8a290",
      "name": "Choose Topic + Publish Time"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://video-worker:8000/v1/render",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 900000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -190,
        160
      ],
      "id": "63d5f5a0-8068-4d03-9798-59061b8e9bf1",
      "name": "Render Video",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 60000
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nif (item.json.alreadyUploaded === true) {\n  return [];\n}\nreturn [item];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        70,
        160
      ],
      "id": "8c0d5742-a046-4d6a-aa66-1f8b8b532883",
      "name": "Skip Already Uploaded"
    },
    {
      "parameters": {
        "url": "={{ $('Render Video').first().json.videoUrl }}",
        "options": {
          "timeout": 900000,
